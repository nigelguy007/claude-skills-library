# One LLM provider (Anthropic is used if both are set, unless VJ_LLM_PROVIDER says otherwise)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# VJ_LLM_PROVIDER=anthropic
# VJ_SMART_MODEL=claude-sonnet-5-5
# VJ_FAST_MODEL=claude-haiku-4-5-20251001

# At least one search provider; extras are used as fallbacks in this order
TAVILY_API_KEY=
BRAVE_API_KEY=
SERPAPI_API_KEY=

# Optional
# VJ_CACHE_DIR=~/.cache/verified-journalist
# VJ_USER_AGENT=YourOrg-Journalist/1.0 (+https://your.site/contact)
