# --- Required ---
ANTHROPIC_API_KEY=sk-ant-...
RECALL_API_KEY=...                 # recall.ai dashboard -> API keys
RECALL_REGION=eu-central-1          # must match your Recall account region (us-east-1, us-west-2, eu-central-1, ap-northeast-1)
PUBLIC_BASE_URL=https://your-app.onrender.com   # where Recall can reach this server (no trailing slash)
WEBHOOK_TOKEN=make-this-long-and-random
ADMIN_TOKEN=another-long-random-value          # visit /?key=<ADMIN_TOKEN> once to sign in

# --- Identity ---
BOT_NAME=Atlas (AI consultant)
WAKE_WORDS=atlas                   # what people say to address it; pick a word speech recognition hears reliably

# --- Models ---
LIVE_MODEL=claude-sonnet-5-5
DEEP_MODEL=claude-opus-5-5
FAST_MODEL=claude-haiku-5-5
WEB_SEARCH=true

# --- Second opinions (optional; each is used only if its key is set) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
PERPLEXITY_API_KEY=
PERPLEXITY_MODEL=sonar-pro
# Any OpenAI-compatible chat API (e.g. Genspark, OpenRouter) if you have one:
CUSTOM_LLM_NAME=
CUSTOM_LLM_URL=
CUSTOM_LLM_KEY=
CUSTOM_LLM_MODEL=

# --- Voice in meetings (optional) ---
TTS_PROVIDER=none                  # none | openai | elevenlabs
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# --- Participation policy ---
DEFAULT_MODE=chat                  # chat | voice
PROACTIVE_THRESHOLD=8              # 0-10: how valuable a point must be before it speaks up unprompted
PROACTIVE_MIN_GAP_S=240            # minimum seconds between unprompted contributions
ANALYSIS_INTERVAL_S=90
MAX_AUTO_RESEARCH=6

# --- Skills: comma-separated folders to index (this repo's skills/ is the default) ---
# SKILLS_DIRS=/app/skills,/root/.claude/skills

# --- Send a link to the memo and notes when a meeting ends (Slack incoming webhook) ---
NOTIFY_WEBHOOK_URL=
